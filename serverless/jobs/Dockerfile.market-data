FROM eclipse-temurin:25-jdk AS java-build

WORKDIR /src/java
COPY java /src/java
COPY contracts /src/contracts
RUN ./gradlew --no-daemon :control-plane:bootJar \
    && find control-plane/build/libs -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' \
        -exec cp '{}' /tmp/control-plane.jar ';'

FROM python:3.11-slim

WORKDIR /job

ENV PYTHONPATH=/job/backend \
    PYTHONUNBUFFERED=1 \
    GIT_PYTHON_REFRESH=quiet \
    JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:${PATH}

COPY --from=java-build /opt/java/openjdk /opt/java/openjdk
COPY --from=java-build /tmp/control-plane.jar /job/java/control-plane.jar
COPY serverless/jobs/requirements.txt /job/serverless/jobs/requirements.txt

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 openssl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r /job/serverless/jobs/requirements.txt

COPY backend/app /job/backend/app
COPY scripts/generate_features.py /job/scripts/generate_features.py
COPY configs/features /job/configs/features
COPY configs/data /job/configs/data
COPY configs/benchmark /job/configs/benchmark
COPY serverless/jobs /job/serverless/jobs

RUN java -version \
    && python -c "from app.market_data.acquisition import execute_acquisition_s3; from app.market_data.preparation import execute_preparation_s3" \
    && python /job/serverless/jobs/run_market_data_wave1.py acquire-s3 --help >/dev/null \
    && python /job/serverless/jobs/run_market_data_wave1.py prepare-s3 --help >/dev/null

ENTRYPOINT ["python", "/job/serverless/jobs/run_market_data_wave1.py"]
CMD ["--help"]
