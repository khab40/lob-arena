{
  "name": "lob-arena-frontend",
  "description": "A research and validation platform that replays licensed historical order-book data, injects controlled synthetic attacks, and benchmarks surveillance detectors against reproducible ground truth.",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.46.3",
    "vite": "8.0.16"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2.0.0": "1.1.16",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.2",
      "js-yaml@>=4.0.0 <5.0.0": "4.3.0"
    }
  }
}
