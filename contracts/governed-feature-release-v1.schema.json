{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "properties": {
        "logical_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Logical Name",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "logical_name",
        "uri",
        "sha256",
        "size_bytes",
        "schema_version"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "GovernedFeatureReleaseShard": {
      "additionalProperties": false,
      "properties": {
        "base_session_id": {
          "minLength": 1,
          "title": "Base Session Id",
          "type": "string"
        },
        "campaign_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Id"
        },
        "features": {
          "$ref": "#/$defs/ArtifactDigest"
        },
        "fold": {
          "enum": [
            "train",
            "validation",
            "test"
          ],
          "title": "Fold",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/ArtifactDigest"
        },
        "replay_manifest": {
          "$ref": "#/$defs/ArtifactDigest"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "run_metadata": {
          "$ref": "#/$defs/ArtifactDigest"
        }
      },
      "required": [
        "fold",
        "base_session_id",
        "campaign_id",
        "run_id",
        "replay_manifest",
        "run_metadata",
        "features",
        "quality"
      ],
      "title": "GovernedFeatureReleaseShard",
      "type": "object"
    }
  },
  "$id": "https://lob-arena.local/contracts/governed-feature-release-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adjudications": {
      "$ref": "#/$defs/ArtifactDigest"
    },
    "assignment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assignment Hash",
      "type": "string"
    },
    "corpus_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Hash",
      "type": "string"
    },
    "corpus_id": {
      "minLength": 1,
      "title": "Corpus Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "feature_config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Config Hash",
      "type": "string"
    },
    "feature_schema_version": {
      "minLength": 1,
      "title": "Feature Schema Version",
      "type": "string"
    },
    "protocol_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Hash",
      "type": "string"
    },
    "protocol_id": {
      "minLength": 1,
      "title": "Protocol Id",
      "type": "string"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "governed_feature_release_v1"
    },
    "shards": {
      "items": {
        "$ref": "#/$defs/GovernedFeatureReleaseShard"
      },
      "minItems": 1,
      "title": "Shards",
      "type": "array"
    },
    "split_id": {
      "minLength": 1,
      "title": "Split Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "protocol_id",
    "protocol_hash",
    "corpus_id",
    "corpus_hash",
    "split_id",
    "assignment_hash",
    "feature_schema_version",
    "feature_config_hash",
    "adjudications",
    "shards"
  ],
  "title": "LOB Arena Governed Feature Release v1",
  "type": "object"
}
