{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lob-arena.local/contracts/canonical-java-replay-bundle-v1.schema.json",
  "title": "LOB Arena Canonical Java Replay Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "base_session_id",
    "dataset_id",
    "mode",
    "instrument",
    "venue",
    "session_id",
    "session_date",
    "price_tick_size",
    "quantity_lot_size",
    "tick_interval_ns",
    "java_engine_version",
    "canonical_event_schema_version",
    "canonical_event_stream_hash",
    "event_count",
    "snapshot_count",
    "alert_count",
    "label_count",
    "first_sequence",
    "last_sequence",
    "first_timestamp_ns",
    "last_timestamp_ns",
    "events",
    "snapshots",
    "alerts",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "canonical_java_replay_bundle_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "base_session_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["historical_control", "synthetic", "hybrid"]},
    "campaign_id": {"type": ["string", "null"]},
    "attack_family": {"type": ["string", "null"], "minLength": 1},
    "instrument": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "session_date": {"type": "string", "format": "date"},
    "seed": {"type": ["integer", "null"], "minimum": 0},
    "price_tick_size": {"type": "number", "exclusiveMinimum": 0},
    "quantity_lot_size": {"type": "number", "exclusiveMinimum": 0},
    "tick_interval_ns": {"type": "integer", "exclusiveMinimum": 0},
    "java_engine_version": {"type": "string", "minLength": 1},
    "canonical_event_schema_version": {"type": "integer", "minimum": 1},
    "canonical_event_stream_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_count": {"type": "integer", "minimum": 1},
    "snapshot_count": {"type": "integer", "minimum": 1},
    "alert_count": {"type": "integer", "minimum": 0},
    "label_count": {"type": "integer", "minimum": 0},
    "first_sequence": {"const": 1},
    "last_sequence": {"type": "integer", "minimum": 1},
    "first_timestamp_ns": {"type": "integer", "minimum": 0},
    "last_timestamp_ns": {"type": "integer", "minimum": 0},
    "events": {"$ref": "#/$defs/artifact"},
    "snapshots": {"$ref": "#/$defs/artifact"},
    "alerts": {"$ref": "#/$defs/artifact"},
    "ground_truth": {
      "oneOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "null"}
      ]
    },
    "validation": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri", "sha256", "size_bytes", "schema_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "historical_control"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "campaign_id": {"type": "null"},
          "attack_family": {"type": "null"},
          "seed": {"type": "null"},
          "ground_truth": {"type": "null"},
          "label_count": {"const": 0}
        }
      },
      "else": {
        "required": ["campaign_id", "attack_family", "seed", "ground_truth"],
        "properties": {
          "campaign_id": {"type": "string", "minLength": 1},
          "attack_family": {"type": "string", "minLength": 1},
          "seed": {"type": "integer", "minimum": 0},
          "ground_truth": {"$ref": "#/$defs/artifact"},
          "label_count": {"const": 1}
        }
      }
    }
  ]
}
