{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lob-arena.local/contracts/benchmark-results-v2.schema.json",
  "title": "LOB Arena Governed Benchmark Results v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "protocol_id",
    "protocol_hash",
    "corpus_id",
    "corpus_hash",
    "split_id",
    "assignment_hash",
    "fold",
    "metrics",
    "confidence_intervals",
    "paired_comparisons",
    "regime_matrix",
    "worst_decile",
    "input_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "governed_benchmark_results_v2"},
    "model_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_id": {"type": "string", "minLength": 1},
    "assignment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fold": {"enum": ["train", "validation", "test"]},
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative",
        "precision",
        "recall",
        "f1",
        "false_alerts_per_million_events",
        "attack_level_recall",
        "detection_before_benefit_rate",
        "duplicate_alert_load"
      ],
      "properties": {
        "schema_version": {"const": "governed_operational_metrics_v1"},
        "true_positive": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0},
        "true_negative": {"type": "integer", "minimum": 0},
        "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "f1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "attack_level_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "false_alerts_per_million_events": {"type": ["number", "null"], "minimum": 0},
        "detection_before_benefit_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "duplicate_alert_load": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "confidence_intervals": {
      "$ref": "#/$defs/intervalMatrix"
    },
    "paired_comparisons": {
      "$ref": "#/$defs/pairedMatrix"
    },
    "regime_matrix": {
      "type": "object",
      "required": ["schema_version", "minimum_cell_count", "dimensions"],
      "properties": {
        "schema_version": {"const": "regime_metric_matrix_v1"},
        "minimum_cell_count": {"type": "integer", "minimum": 1},
        "dimensions": {"type": "object"}
      }
    },
    "worst_decile": {
      "type": "object",
      "required": ["schema_version", "fraction", "metrics"],
      "properties": {
        "schema_version": {"const": "worst_decile_results_v1"},
        "fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "metrics": {"type": "object"}
      }
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inputArtifact"}
    }
  },
  "$defs": {
    "intervalMetricNames": {
      "enum": [
        "precision",
        "attack_level_recall",
        "f1",
        "false_alerts_per_million_events",
        "detection_before_benefit_rate",
        "duplicate_alert_load"
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_estimate",
        "lower",
        "upper",
        "confidence_level",
        "resamples",
        "cluster_unit"
      ],
      "properties": {
        "point_estimate": {"type": ["number", "null"]},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "resamples": {"type": "integer", "minimum": 100},
        "cluster_unit": {"const": "base_session"}
      }
    },
    "intervalMatrix": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "propertyNames": {"$ref": "#/$defs/intervalMetricNames"},
      "additionalProperties": {"$ref": "#/$defs/interval"}
    },
    "paired": {
      "type": "object",
      "required": [
        "schema_version",
        "metric",
        "higher_is_better",
        "session_count",
        "baseline",
        "candidate",
        "difference",
        "difference_confidence_interval",
        "wins",
        "ties",
        "losses",
        "statistically_resolved"
      ],
      "properties": {
        "schema_version": {"const": "paired_session_comparison_v1"},
        "metric": {"type": "string"},
        "higher_is_better": {"type": "boolean"},
        "session_count": {"type": "integer", "minimum": 1},
        "baseline": {"type": ["number", "null"]},
        "candidate": {"type": ["number", "null"]},
        "difference": {"type": ["number", "null"]},
        "difference_confidence_interval": {"type": "object"},
        "wins": {"type": "integer", "minimum": 0},
        "ties": {"type": "integer", "minimum": 0},
        "losses": {"type": "integer", "minimum": 0},
        "statistically_resolved": {"type": "boolean"}
      }
    },
    "pairedMatrix": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "propertyNames": {"$ref": "#/$defs/intervalMetricNames"},
      "additionalProperties": {"$ref": "#/$defs/paired"}
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest", "manifest_sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_session_id": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]},
        "mode": {"enum": ["historical_control", "synthetic", "hybrid", null]},
        "campaign_id": {"type": ["string", "null"]},
        "java_canonical_event_stream_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
