# Public release configuration only; Google/session/custody config stays private.
# Set this to the immutable tag of the exact reviewed and tested commit.
CEO_RELEASE_TAG=ceo-demo-20261012-r1
# Existing parent, absolute nonsymlinked path, disjoint from retained custody/state.
CEO_RELEASE_RUNTIME_DIR=/absolute/project/outputs/ceo-release-runtime
# Required decimal values from id -u / id -g, matching that directory's owner.
CEO_RELEASE_UID=REPLACE_WITH_ID_U
CEO_RELEASE_GID=REPLACE_WITH_ID_G
NEBIUS_SERVERLESS_ENABLED=false
NEBIUS_ENDPOINT_MODE=mock
